# Скопируйте в .env.local и заполните. .env.local в git не попадает.

# Куда проксировать /api и /media в режиме разработки.
API_TARGET=https://alterlit.ru

# Префикс, с которого бэкенд отдаёт статику острова (используется только при сборке).
STATIC_BASE=/assets/images_list/

# Куки залогиненной сессии alterlit.ru — их подставляет только dev-прокси.
# Берутся из DevTools → Application → Cookies на alterlit.ru.
# Без префикса VITE_ намеренно: так они не могут попасть в клиентский бандл.
# Это рабочая сессия — не коммитьте и не передавайте дальше.
DEV_SESSION_ID=
DEV_CSRF_TOKEN=
